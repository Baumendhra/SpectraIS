# Environment Configuration for SpectraIS Copilot

# Application
PROJECT_NAME="AI Procurement Standards & Compliance Copilot"
ENVIRONMENT=production

# Security & Tokens
SECRET_KEY=CHANGE_THIS_TO_A_32_CHAR_RANDOM_SECRET_KEY_FOR_ACCESS_TOKENS
REFRESH_SECRET_KEY=CHANGE_THIS_TO_A_32_CHAR_RANDOM_SECRET_KEY_FOR_REFRESH_TOKENS
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spectrais_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/spectrais_db

# Redis Caching & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
